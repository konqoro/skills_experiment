.nimcache/
nimcache/
*.o
*.so
*.dll
*.dylib
*.exe
*.a
crash-*
tea_debug.log
/atlas.md

# Compiled test binaries (no extension): ignore, but track .nim sources and _src/ dirs
tests/*_verification/test_*
!tests/*_verification/test_*.nim
!tests/*_verification/test_*/
tests/*_verification/tmp_*
!tests/*_verification/tmp_*.nim
tests/nimonyplugins_verification/nimcache/

# Track source files inside _src/ subdirectories, ignore compiled artifacts
tests/*_verification/*_src/*
!tests/*_verification/*_src/*.nim
!tests/*_verification/*_src/*.c
!tests/*_verification/*_src/*.h

blind_trials/*/fixtures/build/*.so
tictactoe/libraylib.so
